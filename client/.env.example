# ==============================================================================
# CampusFlow Client — Production Environment Configuration Template
# ==============================================================================
# All variables defined here will be bundled into public client-side JavaScript.
# NEVER include private service keys or API secret tokens here!
# ==============================================================================

# Public Supabase URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Publishable / Anon Key (Protected by PostgreSQL Row Level Security)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: Dedicated Backend or Supabase Edge Functions Base URL
# Leave blank to use relative paths (/functions/v1) with Vite proxy or Vercel rewrites.
VITE_API_URL=

# Demo Mode Fallback
VITE_ENABLE_DEMO_FALLBACK=true
