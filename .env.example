# ==============================================================================
# CampusFlow — Environment Configuration Template
# ==============================================================================
# For local development with Supabase, copy this file to .env or client/.env:
#   cp .env.example .env
#   cp .env.example client/.env
#
# Replace the placeholders with your actual Supabase project credentials.
# NEVER commit real credentials or service-role keys to version control.
# ==============================================================================

# Public Supabase URL (e.g. https://xyzcompany.supabase.co or http://127.0.0.1:54321)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public / Anon Publishable API Key (safe for client-side frontend use)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: Demo Mode Fallback (defaults to true if Supabase is unconfigured)
VITE_ENABLE_DEMO_FALLBACK=true
