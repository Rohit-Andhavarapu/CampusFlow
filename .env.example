# ==============================================================================
# CampusFlow — Comprehensive Production Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY GUIDELINES:
# 1. Variables prefixed with VITE_ are embedded into public frontend browser bundles.
# 2. Never prefix secret keys (Groq API keys, Supabase Service Role keys) with VITE_.
# 3. Keep backend secrets strictly in your secure backend server or Supabase Edge Functions.
# 4. Never commit real credentials to Git or public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIGURATION (Safe for Browser & Client Bundles)
# ------------------------------------------------------------------------------
# Public Supabase URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public / Anon Publishable API Key (Enforces PostgreSQL Row Level Security)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: Dedicated Backend or Supabase Edge Functions Base URL
# Leave blank to use relative paths (/functions/v1) with Vite proxy or Vercel rewrites.
# For direct Edge Functions in production: https://your-project-ref.supabase.co
VITE_API_URL=

# Demo Mode Fallback (defaults to true if Supabase connection is unconfigured)
VITE_ENABLE_DEMO_FALLBACK=true

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE SECRETS (TRUSTED SERVERS & EDGE FUNCTIONS ONLY)
# ------------------------------------------------------------------------------
# Supabase Administrative / Service Role Secret Key (Bypasses RLS — NEVER expose to browser)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Groq LPU™ Cloud AI API Key (Used strictly on server for resume intelligence parsing)
GROQ_API_KEY=your-groq-api-key-here

# Groq AI Model Designation
# Recommended: openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# Local Intelligence Backend Server Port (defaults to 3001)
PORT=3001
